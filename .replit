modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 26245
externalPort = 80

[userenv]

[userenv.shared]
VITE_EMAILJS_SERVICE_ID = "service_gzmgyoh"
VITE_EMAILJS_TEMPLATE_ID = "template_nq9b5wp"
VITE_EMAILJS_PUBLIC_KEY = "uGGKwBMTn6iCC9aiw"

[nix]
channel = "stable-25_05"
